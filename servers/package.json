{
  "name": "gateway",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start:restaurant": "cross-env APP_SERVICE=restaurant nest start restaurant --watch",
    "start:users": "cross-env APP_SERVICE=users nest start users --watch",
    "start:restaurant:prod": "cross-env NODE_ENV=production APP_SERVICE=restaurant nest start restaurant",
    "start:users:prod": "cross-env NODE_ENV=production APP_SERVICE=users nest start users",
    "prisma:generate:restaurant": "cross-env APP_SERVICE=restaurant prisma generate --schema=apps/restaurant/prisma/schema.prisma",
    "prisma:generate:users": "cross-env APP_SERVICE=users prisma generate --schema=apps/users/prisma/schema.prisma",
    "prisma:push:restaurant": "cross-env APP_SERVICE=restaurant prisma db push --schema=apps/restaurant/prisma/schema.prisma",
    "prisma:push:users": "cross-env APP_SERVICE=users prisma db push --schema=apps/users/prisma/schema.prisma",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@apollo/gateway": "^2.9.3",
    "@apollo/subgraph": "^2.9.3",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^6.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/ejs": "^3.1.5",
    "bcrypt": "^5.1.1",
    "class-validator": "^0.14.1",
    "ejs": "^3.1.10",
    "graphql": "^16.9.0",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
